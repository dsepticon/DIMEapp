{
  "name": "dime-react-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "tsx server/local.ts",
    "lint": "eslint app shared server tests scripts *.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain.test.ts tests/auth.test.ts tests/client.test.ts",
    "test:integration": "vitest run tests/service.test.ts tests/dynamo.test.ts tests/local.test.ts",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write app shared server tests scripts *.ts *.json *.html",
    "format:check": "prettier --check app shared server tests scripts *.ts *.json *.html"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1130.0",
    "@aws-sdk/lib-dynamodb": "3.1130.0",
    "jose": "6.2.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
