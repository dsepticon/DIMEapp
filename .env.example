# Frontend: explicit loopback development only. Never use local for a release build.
VITE_DIME_MODE=local
VITE_DIME_API_URL=http://127.0.0.1:8787
# Separate local backend command: DIME_ENV=local npm run dev:local
DIME_ENV=local
