rule web_runtime_secret_scope {
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_WEB_ID_KEY_B64 !exists
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_AUTH_ENCRYPTION_KEY_B64 !exists
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_OAUTH_CLIENT_SECRET !exists
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_WEB_ID_SECRET_ARN.Ref == 'WebIdentityKeySecretArn'
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_AUTH_ENCRYPTION_SECRET_ARN.Ref == 'AuthEncryptionKeySecretArn'
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_OAUTH_CLIENT_SECRET_ARN.Ref == 'OAuthClientSecretArn'
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_WEB_SIGN_IN_MODE.Ref == 'WebSignInMode'
 Resources.WebAuthFunction.Properties.Environment.Variables.DIME_ACCOUNT_LINKING.Ref == 'AccountLinkingMode'
 Resources.WebAuthExecutionRole.Properties.Policies[0].PolicyDocument.Statement[3].Action == ['secretsmanager:GetSecretValue']
 Resources.WebAuthExecutionRole.Properties.Policies[0].PolicyDocument.Statement[3].Resource == [{'Ref':'WebIdentityKeySecretArn'}, {'Ref':'AuthEncryptionKeySecretArn'}]
 Resources.WebAuthExecutionRole.Properties.Policies[0].PolicyDocument.Statement[3].Condition.StringEquals.'secretsmanager:VersionStage' == ['AWSCURRENT', 'AWSPENDING']
 Resources.WebAuthExecutionRole.Properties.Policies[0].PolicyDocument.Statement[4].Action == ['secretsmanager:GetSecretValue']
 Resources.WebAuthExecutionRole.Properties.Policies[0].PolicyDocument.Statement[4].Resource == [{'Ref':'OAuthClientSecretArn'}]
 Resources.WebAuthExecutionRole.Properties.Policies[0].PolicyDocument.Statement[4].Condition.StringEquals.'secretsmanager:VersionStage' == 'AWSCURRENT'
 Parameters.WebSignInMode.Default == 'DISABLED'
 Parameters.AccountLinkingMode.Default == 'DISABLED'
}
