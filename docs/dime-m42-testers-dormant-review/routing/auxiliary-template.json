    "AuthMethodGuard": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": "dime-auth-exact-methods-20260916",
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Exact auth paths/methods/query names only; does not inspect credential values",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "// Review only. No logging, credential validation, value inspection or origin mutation.\nvar routes = {\"/auth/login\":{\"method\":\"GET\",\"query\":[\"invitation\"]},\"/auth/callback\":{\"method\":\"GET\",\"query\":[\"code\",\"state\",\"error\",\"scope\",\"error_description\"]},\"/auth/status\":{\"method\":\"GET\",\"query\":[]},\"/auth/session\":{\"method\":\"GET\",\"query\":[\"view\"]},\"/auth/logout\":{\"method\":\"POST\",\"query\":[]},\"/auth/link/intent\":{\"method\":\"POST\",\"query\":[]},\"/auth/link/accept\":{\"method\":\"POST\",\"query\":[]},\"/auth/unlink\":{\"method\":\"POST\",\"query\":[]},\"/auth/delete/intent\":{\"method\":\"POST\",\"query\":[]},\"/auth/delete/resume\":{\"method\":\"POST\",\"query\":[]}};\nfunction denied(code) {\n  return {statusCode:code, headers:{'cache-control':{value:'no-store'},'referrer-policy':{value:'no-referrer'},'content-type':{value:'application/json'}},body:'{\"message\":\"Request unavailable.\"}'};\n}\nfunction handler(event) {\n  var request=event.request, rule=routes[request.uri];\n  if (!rule) return denied(404);\n  if (request.method!==rule.method && request.method!=='OPTIONS') return denied(405);\n  var names=Object.keys(request.querystring || {});\n  for (var i=0;i<names.length;i++) if (rule.query.indexOf(names[i])<0) return denied(400);\n  return request;\n}\n"
      }
    },
    "AuthResponsePolicy": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": "dime-auth-no-store-20260916",
          "Comment": "Only exact auth paths. Preserve origin nonce CSP and CORS.",
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            }
          },
          "CustomHeadersConfig": {
            "Items": [
              {
                "Header": "Cache-Control",
                "Value": "no-store, private, max-age=0",
                "Override": true
              },
              {
                "Header": "Pragma",
                "Value": "no-cache",
                "Override": true
              }
            ]
          }
        }
      }
